rules_version = '2';

// GasUp365 Firestore rules. They match the only two client writers:
// CameraCaptureScreen (markers) and AuthScreen (users/{uid}).
// Tests: npm run test:rules (firestore/rules.test.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function optionalString(data, key, maxSize) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxSize);
    }

    function validPrice(value) {
      return value == null || (value is number && value > 0 && value < 1000);
    }

    function validPrices(prices) {
      return prices is map
        && prices.keys().hasOnly(['diesel', 'unleaded', 'premium'])
        && validPrice(prices.get('diesel', null))
        && validPrice(prices.get('unleaded', null))
        && validPrice(prices.get('premium', null))
        && (prices.get('diesel', null) != null
          || prices.get('unleaded', null) != null
          || prices.get('premium', null) != null);
    }

    function validMarker(data) {
      return data.keys().hasAll(['latitude', 'longitude', 'title', 'prices', 'timestamp'])
        && data.keys().hasOnly([
          'latitude', 'longitude', 'title', 'description', 'imageUrl', 'imageStorage',
          'cloudinaryPublicId', 'prices', 'source', 'ocr', 'timestamp', 'userId'
        ])
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && optionalString(data, 'description', 1000)
        && optionalString(data, 'imageUrl', 2048)
        && (!('imageStorage' in data) || data.imageStorage in ['cloudinary', 'placeholder'])
        && (!('cloudinaryPublicId' in data) || data.cloudinaryPublicId == null || data.cloudinaryPublicId is string)
        && (!('source' in data) || data.source == 'camera-ocr')
        && (!('ocr' in data) || (data.ocr is map && data.ocr.get('rawText', '') is string && data.ocr.get('rawText', '').size() <= 20000))
        && (!('userId' in data) || data.userId == request.auth.uid)
        && validPrices(data.prices)
        && data.timestamp == request.time;
    }

    // Community price updates: any signed-in user can read and add them.
    // Nobody can edit or delete them from the app.
    match /markers/{markerId} {
      allow read: if signedIn();
      allow create: if signedIn() && validMarker(request.resource.data);
      allow update, delete: if false;
    }

    // Profiles: each user reads only their own and creates it once at sign-up
    // with zero points. Updates stay closed until FEAT-003 adds point rules.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'points', 'updates', 'role'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && (request.resource.data.email == null || request.resource.data.email is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.points == 0
        && request.resource.data.updates == 0
        && request.resource.data.role == 'Community Member';
      allow update, delete: if false;
    }
  }
}
